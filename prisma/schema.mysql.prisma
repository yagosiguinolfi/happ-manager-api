datasource db_mysql {
  provider = "mysql"
  url      = env("DATABASE_URL_MYSQL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}
